# Copy to .env and fill in locally. .env is git-ignored: NEVER commit real values.
# In CI the same names are stored as GitHub Actions secrets.
# Nothing in the current scaffold reads these yet; they are reserved for future
# Open Cloud tasks (e.g. publishing a place from CI).

# Open Cloud API key with the minimum scopes needed (create at create.roblox.com > Open Cloud).
ROBLOX_OPEN_CLOUD_API_KEY=
# Experience (universe) and place IDs to publish to.
ROBLOX_UNIVERSE_ID=
ROBLOX_PLACE_ID=
